+        effect.msgSend(void, "setState:", .{@as(isize, 1)}); // Active regardless of focus.
+        effect.msgSend(void, "setMaterial:", .{@as(isize, 21)}); // Under window background.
+        // Reattaching also handles a host replacing the content view.
+        effect.msgSend(void, "removeFromSuperview", .{});
+        content.msgSend(void, "addSubview:positioned:relativeTo:", .{
+            effect.value,
+            @as(isize, -1), // Below terminal content.
+            @as(objc.c.id, null),
+        });
     }
 
