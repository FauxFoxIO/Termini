+    // An address-stable association prevents duplicate effect views and ties
+    // the view's lifetime to its window without owning host application state.
+    var public_window_blur_key: u8 = 0;
+
+    fn setPublicWindowBlur(block: *const PublicWindowBlurBlock.Context) callconv(.c) void {
+        const macos = @import("macos");
+        const window = objc.Object.fromId(block.window);
+        const associated = objc_getAssociatedObject(block.window, &public_window_blur_key);
+        if (!block.enabled) {
+            if (associated) |view| {
+                objc.Object.fromId(view).msgSend(void, "removeFromSuperview", .{});
+                objc_setAssociatedObject(block.window, &public_window_blur_key, null, 1);
+            }
+            return;
+        }
+
+        const content = window.msgSend(objc.Object, "contentView", .{});
+        if (content.value == null) return;
+        const bounds = content.msgSend(macos.graphics.Rect, "bounds", .{});
+        const effect = if (associated) |view|
+            objc.Object.fromId(view)
+        else effect: {
+            const NSVisualEffectView = objc.getClass("NSVisualEffectView") orelse return;
+            const allocated = NSVisualEffectView.msgSend(objc.Object, "alloc", .{});
+            const view = allocated.msgSend(objc.Object, "initWithFrame:", .{bounds});
+            if (view.value == null) return;
+            // OBJC_ASSOCIATION_RETAIN_NONATOMIC keeps the effect available even
+            // when the host replaces its content view between appearance updates.
+            objc_setAssociatedObject(block.window, &public_window_blur_key, view.value, 1);
+            view.release();
+            break :effect view;
+        };
+        effect.msgSend(void, "setFrame:", .{bounds});
+        effect.msgSend(void, "setAutoresizingMask:", .{@as(usize, 2 | 16)});
